# Fallback generic logic mapping, including mapping storage into flip-flops.
# This is not an SRAM-macro or FPGA-BRAM area estimate.
read_verilog -sv rtl/mac_pe.sv rtl/systolic_array.sv rtl/sync_dp_ram.sv rtl/memory_gemm.sv
synth -top memory_gemm -flatten
check -assert
stat -width
write_json build/memory_gemm_generic.json
write_verilog -noattr build/memory_gemm_generic.v
